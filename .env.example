# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Replica Set recommended for multi-document ACID transactions)
MONGO_URI=mongodb://localhost:27017/bank_ledger

# JSON Web Token Secret Key (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Email Service (Nodemailer / OAuth2 Gmail - Optional)
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_oauth_client_id
CLIENT_SECRET=your_oauth_client_secret
REFRESH_TOKEN=your_oauth_refresh_token
